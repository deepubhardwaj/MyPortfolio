  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <meta content="#090b12" name="theme-color"/>
  <meta content="Deepu Bhardwaj &mdash; Computer Science Student, Developer and Problem Solver." name="description"/>
  <title>
   Deepu Bhardwaj | Portfolio

  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&amp;family=Manrope:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
  <style>
   :root
{
    --bg:#090b12;
    --panel:#10131d;
    --panel2:#141826;
    --text:#f4f6ff;
    --muted:#a2a9bd;
    --line:rgba(255,255,255,.1);
    --accent:#a6ffcb;
    --accent2:#8b9bff;
    --max:1120px;
}
*
{
    box-sizing:border-box;
}
html
{
    scroll-behavior:smooth;
    scroll-padding-top:90px;
}
body
{
    margin:0;
    background:radial-gradient(ellipse at 85% 0%,rgba(106,116,255,.12),transparent 35%),
            radial-gradient(ellipse at 0% 35%,rgba(65,220,160,.06),transparent 30%),var(--bg);
    color:var(--text);
    font-family:Manrope,system-ui,sans-serif;
    line-height:1.65;
}
a
{
    color:inherit;
    text-decoration:none;
}
button
{
    font:inherit;
}
.wrap
{
    width:min(var(--max),calc(100% - 44px));
    margin:auto;
}
.nav
{
    position:sticky;
    top:0;
    z-index:20;
    background:rgba(9,11,18,.8);
    backdrop-filter:blur(18px);
    border-bottom:1px solid var(--line);
}
.navin
{
    height:76px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}
.brand
{
    font-weight:800;
    letter-spacing:-.8px;
    font-size:1.08rem;
}
.brand span
{
    color:var(--accent);
}
.navlinks
{
    display:flex;
    gap:27px;
    align-items:center;
    color:var(--muted);
    font-size:.85rem;
}
.navlinks a:hover,.navlinks a.active
{
    color:var(--accent);
}
.nav-cta
{
    border:1px solid var(--line);
    border-radius:999px;
    padding:9px 15px;
    color:var(--text)!important;
}
.menu
{
    display:none;
    background:none;
    border:1px solid var(--line);
    color:white;
    border-radius:10px;
    padding:8px 12px;
}
.hero
{
    min-height:680px;
    display:grid;
    grid-template-columns:1.25fr .75fr;
    align-items:center;
    gap:55px;
    padding:78px 0 90px;
}
.eyebrow,.kicker
{
    font:500 .74rem 'DM Mono',monospace;
    text-transform:uppercase;
    letter-spacing:2px;
    color:var(--accent);
}
.status
{
    display:inline-flex;
    align-items:center;
    gap:9px;
    border:1px solid var(--line);
    padding:7px 12px;
    border-radius:99px;
    font-size:.75rem;
    color:#d3d8e8;
    margin-bottom:25px;
    background:rgba(255,255,255,.025);
}
.dot
{
    width:7px;
    height:7px;
    background:var(--accent);
    border-radius:50%;
    box-shadow:0 0 12px var(--accent);
}
h1
{
    font-size:clamp(3.2rem,7.5vw,6.3rem);
    line-height:.98;
    letter-spacing:-.075em;
    margin:0 0 23px;
    font-weight:800;
}
h1 .gradient
{
    color:var(--accent);
}
.hero p
{
    max-width:620px;
    color:var(--muted);
    font-size:1.04rem;
    margin:0 0 28px;
}
.hero p strong
{
    color:var(--text);
    font-weight:700;
}
.actions
{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}
.btn
{
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:12px 18px;
    border-radius:12px;
    font-size:.88rem;
    font-weight:800;
    border:1px solid var(--line);
    transition:.2s;
    cursor:pointer;
}
.btn-primary
{
    background:var(--accent);
    color:#08120e;
    border-color:var(--accent);
}
.btn:hover
{
    transform:translateY(-3px);
}
.btn-secondary
{
    background:rgba(255,255,255,.03);
}
.socials
{
    display:flex;
    gap:18px;
    margin-top:27px;
    color:var(--muted);
    font-size:.85rem;
}
.socials a:hover
{
    color:var(--accent);
}
.hero-card
{
    position:relative;
    min-height:390px;
    display:grid;
    place-items:center;
}
.orb
{
    position:absolute;
    width:310px;
    height:310px;
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%,rgba(166,255,203,.28),rgba(139,155,255,.13) 48%,transparent 72%);
    filter:blur(4px);
}
.profile
{
    position:relative;
    width:270px;
    height:320px;
    border:1px solid rgba(255,255,255,.16);
    border-radius:28px;
    background:linear-gradient(145deg,rgba(255,255,255,.09),rgba(255,255,255,.02));
    backdrop-filter:blur(12px);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    box-shadow:0 25px 90px #0008;
    transform:rotate(3deg);
}
.avatar
{
    width:112px;
    height:112px;
    border-radius:30px;
    background:linear-gradient(135deg,var(--accent),var(--accent2));
    display:grid;
    place-items:center;
    color:#101522;
    font-size:3rem;
    font-weight:800;
    letter-spacing:-4px;
    box-shadow:0 12px 45px #a6ffcb22;
}
.profile h2
{
    margin:21px 0 0;
    font-size:1.4rem;
}
.profile small
{
    color:var(--muted);
    font-family:'DM Mono',monospace;
    font-size:.72rem;
}
.float-chip
{
    position:absolute;
    padding:11px 14px;
    border:1px solid var(--line);
    background:#121622;
    border-radius:13px;
    font: .78rem 'DM Mono',monospace;
    box-shadow:0 12px 40px #0005;
}
.chip1
{
    top:50px;
    right:0;
}
.chip2
{
    bottom:53px;
    left:-3px;
}
.chip3
{
    right:2px;
    bottom:7px;
    color:var(--accent);
}
section
{
    padding:83px 0;
    border-top:1px solid var(--line);
}
.section-head
{
    display:flex;
    align-items:end;
    justify-content:space-between;
    gap:25px;
    margin-bottom:34px;
}
.section-head h2
{
    font-size:clamp(2rem,4vw,3.1rem);
    line-height:1.1;
    letter-spacing:-.06em;
    margin:8px 0 0;
}
.section-head p
{
    max-width:430px;
    color:var(--muted);
    font-size:.9rem;
    margin:0;
}
.about-grid
{
    display:grid;
    grid-template-columns:1.15fr .85fr;
    gap:20px;
}
.panel
{
    background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.018));
    border:1px solid var(--line);
    border-radius:20px;
    padding:27px;
}
.panel p
{
    color:var(--muted);
    margin:0 0 15px;
}
.panel p:last-child
{
    margin-bottom:0;
}
.facts
{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}
.fact
{
    padding:19px;
    border-radius:15px;
    background:rgba(255,255,255,.035);
    border:1px solid var(--line);
}
.fact strong
{
    display:block;
    font-size:1.6rem;
    letter-spacing:-1px;
}
.fact span
{
    font-size:.78rem;
    color:var(--muted);
}
.skills-grid
{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}
.skill-card
{
    padding:22px;
    border-radius:17px;
    border:1px solid var(--line);
    background:var(--panel);
}
.skill-card h3
{
    font-size:1rem;
    margin:0 0 15px;
}
.tags
{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}
.tag
{
    padding:7px 10px;
    border:1px solid var(--line);
    border-radius:9px;
    color:#d4d9e9;
    font: .73rem 'DM Mono',monospace;
    background:rgba(255,255,255,.025);
}
.projects
{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:17px;
}
.project
{
    border:1px solid var(--line);
    border-radius:20px;
    background:var(--panel);
    overflow:hidden;
    transition:.25s;
}
.project:hover
{
    transform:translateY(-5px);
    border-color:#a6ffcb55;
}
.project-top
{
    height:145px;
    padding:22px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:radial-gradient(circle at 80% 20%,#8b9bff20,transparent 40%),linear-gradient(135deg,#151a28,#0e111a);
    border-bottom:1px solid var(--line);
}
.project-icon
{
    width:57px;
    height:57px;
    border:1px solid #ffffff20;
    border-radius:16px;
    display:grid;
    place-items:center;
    font-size:1.6rem;
    background:#ffffff08;
}
.project-num
{
    font: .75rem 'DM Mono',monospace;
    color:var(--muted);
}
.project-body
{
    padding:22px;
}
.project-body h3
{
    margin:0 0 9px;
    font-size:1.16rem;
}
.project-body p
{
    margin:0 0 17px;
    color:var(--muted);
    font-size:.86rem;
}
.project-links
{
    display:flex;
    gap:15px;
    margin-top:18px;
    font-size:.8rem;
}
.project-links a
{
    color:var(--accent);
}
.timeline
{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
}
.timeline-item
{
    padding:23px;
    border-left:2px solid var(--accent);
    border-radius:0 15px 15px 0;
    background:var(--panel);
    border-top:1px solid var(--line);
    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);
}
.timeline-item .date
{
    font: .72rem 'DM Mono',monospace;
    color:var(--accent);
}
.timeline-item h3
{
    font-size:1rem;
    margin:9px 0 7px;
}
.timeline-item p
{
    color:var(--muted);
    font-size:.85rem;
    margin:0;
}
.contact-box
{
    padding:clamp(25px,5vw,52px);
    border:1px solid #a6ffcb35;
    border-radius:24px;
    background:radial-gradient(ellipse at 90% 0%,#a6ffcb12,transparent 42%),var(--panel);
}
.contact-box h2
{
    font-size:clamp(2.3rem,5vw,4rem);
    line-height:1.05;
    letter-spacing:-.07em;
    margin:12px 0;
}
.contact-box p
{
    color:var(--muted);
    max-width:570px;
}
.contact-row
{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    flex-wrap:wrap;
    margin-top:26px;
}
.email
{
    color:var(--accent);
    font-family:'DM Mono',monospace;
    font-size:.9rem;
    overflow-wrap:anywhere;
}
.footer
{
    padding:25px 0;
    color:var(--muted);
    font-size:.78rem;
}
.footer-in
{
    display:flex;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
}
.reveal
{
    opacity:0;
    transform:translateY(18px);
    transition:opacity .65s ease,transform .65s ease;
}
.reveal.show
{
    opacity:1;
    transform:translateY(0);
}
.backtop
{
    position:fixed;
    bottom:20px;
    right:20px;
    width:42px;
    height:42px;
    border-radius:13px;
    background:var(--accent);
    color:#07120d;
    display:grid;
    place-items:center;
    font-weight:900;
    opacity:0;
    pointer-events:none;
    transition:.2s;
}
.backtop.visible
{
    opacity:1;
    pointer-events:auto;
}
@media(max-width:800px)
{
    .hero
    {
        grid-template-columns:1fr;
        gap:10px;
        padding-top:55px;
    }
    .hero-card
    {
        min-height:350px;
    }
    .hero-card .profile
    {
        width:240px;
        height:285px;
    }
    .orb
    {
        width:270px;
        height:270px;
    }
    .chip1
    {
        right:8%;
    }
    .chip2
    {
        left:8%;
    }
    .about-grid
    {
        grid-template-columns:1fr;
    }
    .skills-grid
    {
        grid-template-columns:repeat(2,1fr);
    }
    .section-head
    {
        align-items:start;
        flex-direction:column;
    }
    .navlinks
    {
        display:none;
        position:absolute;
        top:75px;
        left:0;
        right:0;
        background:#0d1018;
        padding:20px 24px 25px;
        flex-direction:column;
        align-items:flex-start;
        border-bottom:1px solid var(--line);
    }
    .navlinks.open
    {
        display:flex;
    }
    .menu
    {
        display:block;
    }
}
@media(max-width:560px)
{
    .wrap
    {
        width:min(var(--max),calc(100% - 30px));
    }
    .hero
    {
        min-height:auto;
        padding:48px 0 55px;
    }
    h1
    {
        font-size:clamp(3rem,15vw,4.8rem);
    }
    .hero p
    {
        font-size:.95rem;
    }
    .hero-card
    {
        min-height:320px;
    }
    .skills-grid,.projects,.timeline
    {
        grid-template-columns:1fr;
    }
    section
    {
        padding:62px 0;
    }
    .project-top
    {
        height:125px;
    }
    .facts
    {
        gap:8px;
    }
    .fact
    {
        padding:14px;
    }
    .socials
    {
        flex-wrap:wrap;
    }
    .navin
    {
        height:68px;
    }
    .navlinks
    {
        top:67px;
    }
}
  </style>
